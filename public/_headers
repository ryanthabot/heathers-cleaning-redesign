# Headers for the pages only. Styles, scripts, images and fonts are left to the
# host, which compresses them. A file that says "no-transform" is not compressed.
#
# "no-transform" asks Cloudflare to deliver a page as it is written. Without it,
# Cloudflare's Web Analytics adds a statistics script of its own to every page,
# for every visitor, before anyone has said yes. That would make the cookie banner
# untrue. The statistics script is loaded by consent.js instead, and only after
# the visitor chooses Accept.
#
# Every page needs its own lines here. The structure check (scripts/check_site.py)
# reports a page that has none.
#
# The rest of each line is the caching Cloudflare gives files by default. It is
# repeated because a header in this file takes the place of the default.
#
# See https://developers.cloudflare.com/web-analytics/get-started/
/
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/privacy-policy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/terms-of-use
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/service-agreement
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/cancellation-policy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/cookie-policy
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/sms-messaging-terms
  Cache-Control: public, max-age=0, must-revalidate, no-transform
/accessibility
  Cache-Control: public, max-age=0, must-revalidate, no-transform
